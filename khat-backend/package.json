{
  "name": "khat-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "import:test-dump": "tsx scripts/import-test-dump.ts",
    "migrate:test-dashboard": "tsx scripts/apply-test-dashboard-migration.ts",
    "migrate:test-mashq": "tsx scripts/apply-test-mashq-migration.ts",
    "migrate:test-cut-styles": "tsx scripts/apply-test-cut-pen-style-migration.ts",
    "export:mysql": "node scripts/export-mysql-database.mjs",
    "migrate:test-student-chatroom": "tsx scripts/apply-test-student-chatroom-migration.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "seed-demo": "tsx scripts/seed-demo-data.ts",
    "bundle": "esbuild src/server.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/server.cjs --log-level=warning",
    "test:reports": "tsx scripts/test-reports.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/static": "^7.0.4",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "livekit-server-sdk": "^2.19.1",
    "mysql2": "^3.24.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
