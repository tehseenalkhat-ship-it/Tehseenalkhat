# Copy this file to .env and fill in your real values. Never commit .env itself.

# MariaDB / MySQL connection string. URL-encode special characters in the password
# (e.g. @ -> %40, # -> %23). On shared hosting the host is usually localhost.
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/DBNAME

# Any long random string — used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

PORT=4000

# File uploads (images, PDFs, videos) are stored on this server's disk.
# Default folder: ../uploads next to the app folder (kept across redeploys).
# UPLOAD_DIR=/home/USER/KhatApp/uploads
# MAX_UPLOAD_MB=200

# Optional S3-compatible storage, only used by LiveKit Egress for event recordings.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=

# Public URL of the frontend (used in account emails)
FRONTEND_URL=http://localhost:5173

# Self-hosted LiveKit (local Docker Compose defaults; use strong generated
# credentials and public WSS/HTTPS URLs in production).
LIVEKIT_API_URL=http://localhost:7880
LIVEKIT_WS_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Existing R2 credentials above are also used by LiveKit Egress per recording
# to save MP4s privately under live-events/ in the same bucket.

# Optional site assistant model (OpenAI-compatible chat-completions endpoint).
# For local Ollama: ASSISTANT_BASE_URL=http://localhost:11434/v1
#                   ASSISTANT_MODEL=qwen2.5:3b
# The guided site-help and student placement flow work without a model.
# ASSISTANT_BASE_URL=http://localhost:11434/v1
# ASSISTANT_MODEL=qwen2.5:3b
# ASSISTANT_API_KEY=

# Used once by `npm run create-admin` to bootstrap the very first admin account.
ADMIN_EMAIL=admin@aljamea.org
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Platform Admin
