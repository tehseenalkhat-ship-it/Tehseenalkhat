# Copy this file to .env and fill in your real values. Never commit .env itself.

# MySQL database (keep real credentials in the untracked .env or deployment secrets).
# `localhost` works only when this Node process runs on the same server as MySQL.
# For local development, use an approved SSH tunnel or remote MySQL endpoint.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_mysql_database
DB_USER=your_mysql_user
DB_PASSWORD=replace-with-your-mysql-password

# Any long random string — used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

PORT=4000

# Cloudflare R2 storage (required by the backend)

# Object storage: Cloudflare R2 defaults (required by the backend)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name

# Optional S3-compatible endpoint override for a later MinIO migration.
# Leave these commented/empty for Cloudflare R2 (existing behavior).
# For production MinIO, use the trusted HTTPS S3 API endpoint reachable by the
# backend, users' browsers, and LiveKit Egress; uploads use browser-side signed URLs.
# Do not use localhost or a private-only hostname here for a hosted site.
# R2_ENDPOINT_OVERRIDE=https://storage.example.org
# R2_FORCE_PATH_STYLE=true
# R2_REGION=us-east-1

# Public URL of the frontend (used in account emails)
FRONTEND_URL=http://localhost:5173

# Self-hosted LiveKit (local Docker Compose defaults; use strong generated
# credentials and public WSS/HTTPS URLs in production).
LIVEKIT_API_URL=http://localhost:7880
LIVEKIT_WS_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Existing R2 credentials above are also used by LiveKit Egress per recording
# to save MP4s privately under live-events/ in the same bucket.

# Optional site assistant model (OpenAI-compatible chat-completions endpoint).
# For local Ollama: ASSISTANT_BASE_URL=http://localhost:11434/v1
#                   ASSISTANT_MODEL=qwen2.5:3b
# The guided site-help and student placement flow work without a model.
# ASSISTANT_BASE_URL=http://localhost:11434/v1
# ASSISTANT_MODEL=qwen2.5:3b
# ASSISTANT_API_KEY=

# Used once by `npm run create-admin` to bootstrap the very first admin account.
ADMIN_EMAIL=admin@aljamea.org
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Platform Admin
